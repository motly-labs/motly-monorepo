---
/**
 * A live example: `src/examples/<name>/index.html` and `main.js` (or `main.jsx`), shown as code and
 * run in an iframe from `/embed/<name>/`. The code on the page is the code that ran.
 */
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';

interface Props {
  name: string;
  /** Stage height in CSS pixels. */
  height?: number;
  /** Add a link that opens the example on its own page, for one that wants more room. */
  full?: boolean;
}

const { name, height = 280, full = false } = Astro.props;

const sources = import.meta.glob<string>('../examples/*/{index.html,main.js,main.jsx}', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const html = sources[`../examples/${name}/index.html`];
const jsx = sources[`../examples/${name}/main.jsx`];
const js = jsx ?? sources[`../examples/${name}/main.js`];
if (html === undefined || js === undefined) {
  throw new Error(`Example "${name}" needs src/examples/${name}/index.html and main.js.`);
}

const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/embed/${name}/`;
---

<figure class="motly-example not-content">
  <iframe src={src} title={`Live example: ${name}`} loading="lazy" style={`height: ${height}px`}
  ></iframe>
  <button type="button" data-replay>Replay</button>
  {full && <a href={src} target="_blank">Open full page ↗</a>}
</figure>
<Tabs>
  <TabItem label={jsx === undefined ? 'JavaScript' : 'JSX'}>
    <Code code={js} lang={jsx === undefined ? 'js' : 'jsx'} />
  </TabItem>
  <TabItem label="HTML"><Code code={html} lang="html" /></TabItem>
</Tabs>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-replay]')) {
    button.addEventListener('click', () => {
      button.closest('figure')?.querySelector('iframe')?.contentWindow?.location.reload();
    });
  }
</script>

<style>
  .motly-example {
    position: relative;
    margin: 1.5rem 0 0;
  }
  iframe {
    display: block;
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color-scheme: dark;
  }
  button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid #ffffff33;
    border-radius: 999px;
    background: #ffffff14;
    color: #f5e9ff;
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  button:hover {
    background: #ffffff29;
  }
  a {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
</style>

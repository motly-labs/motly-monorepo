{
  "name": "@motly/core",
  "version": "0.1.1",
  "description": "Renderer-agnostic procedural motion-graphics engine. Zero runtime dependencies.",
  "homepage": "https://motly-labs.github.io/motly-monorepo/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motly-labs/motly-monorepo.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./svg": {
      "import": {
        "types": "./dist/svg/index.d.mts",
        "default": "./dist/svg/index.mjs"
      },
      "require": {
        "types": "./dist/svg/index.d.cts",
        "default": "./dist/svg/index.cjs"
      }
    },
    "./canvas": {
      "import": {
        "types": "./dist/canvas/index.d.mts",
        "default": "./dist/canvas/index.mjs"
      },
      "require": {
        "types": "./dist/canvas/index.d.cts",
        "default": "./dist/canvas/index.cjs"
      }
    },
    "./auto": {
      "import": {
        "types": "./dist/auto/index.d.mts",
        "default": "./dist/auto/index.mjs"
      },
      "require": {
        "types": "./dist/auto/index.d.cts",
        "default": "./dist/auto/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "size-limit": "^14.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
